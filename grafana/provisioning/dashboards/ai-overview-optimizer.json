{
  "title": "AI Overview · 提示词优化器看板",
  "uid": "ai-overview-optimizer",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "优化器请求速率（按操作 / 结果）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ai_optimizer_requests_total[5m])) by (operation, outcome)",
          "legendFormat": "{{operation}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 15 } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "成功率（30m）",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ai_optimizer_requests_total{outcome=\"success\"}[30m])) / clamp_min(sum(rate(ai_optimizer_requests_total[30m])), 0.0001)",
          "legendFormat": "成功率"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.95 }, { "color": "green", "value": 0.99 } ] } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "错误请求（5m）",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(ai_optimizer_requests_total{outcome=\"error\"}[5m]))",
          "legendFormat": "错误次数"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "首字延迟（TTFT）p50 / p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_optimizer_ttft_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(ai_optimizer_ttft_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "请求量（按模型）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ai_optimizer_requests_total[5m])) by (model)",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Token 消耗速率（输入 / 输出）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ai_llm_tokens_total{scene=\"prompt-optimizer\"}[5m])) by (type)",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "单次请求 Token 强度（输入 / 输出）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(ai_llm_tokens_total{scene=\"prompt-optimizer\", type=\"prompt\"}[5m])) / clamp_min(sum(increase(ai_optimizer_requests_total{outcome=\"success\"}[5m])), 0.0001)",
          "legendFormat": "输入 token / 次"
        },
        {
          "expr": "sum(increase(ai_llm_tokens_total{scene=\"prompt-optimizer\", type=\"completion\"}[5m])) / clamp_min(sum(increase(ai_optimizer_requests_total{outcome=\"success\"}[5m])), 0.0001)",
          "legendFormat": "输出 token / 次"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      }
    }
  ]
}
