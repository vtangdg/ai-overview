# Maven构建目录
/target

# IDE相关文件
.idea/
.vscode/
*.iml
*.ipr
*.iws

# 操作系统文件
.DS_Store
Thumbs.db

# 日志文件
*.log
logs/

# 本地环境配置
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Git相关文件
.git/
.gitignore

# 测试相关
/src/test/
/src/integration-test/

# 临时文件
*.tmp
*.temp
.cache/

# 文档目录
doc/

# Maven本地仓库
.m2/

# Docker相关
.dockerignore
# 精确控制构建上下文：只保留要 COPY 进镜像的 fat jar
# （注意 /target 只匹配 backend 根目录，ai-demo/target 的 classes 等中间产物会全量进上下文）
ai-demo/target/*
!ai-demo/target/backend-ai-demo-0.0.1-SNAPSHOT.jar

# 运行时通过 volume/挂载提供，不需要进镜像与上下文
ai-demo/db/
ai-demo/logs/
**/logs/
